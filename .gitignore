# Telecom X - Global Git Ignore
# Root Level .gitignore
# Author: Elizabeth Díaz Familia

# ====================  NODE / NPM ====================
node_modules/
package-lock.json
.npm/
.eslintcache

# ==================== PYTHON ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
*.egg-info/

# ==================== ENVIRONMENT VARIABLES ====================
.env
.env.local
.env.*.local
*.env

# ==================== IDE / EDITORS ====================
# VSCode
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ==================== OPERATING SYSTEM ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ==================== LOGS ====================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== BUILD OUTPUT ====================
dist/
build/
*.tsbuildinfo

# ==================== TESTING ====================
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
test-results/

# ==================== MISC ====================
.cache/
.temp/
.tmp/
*.tmp
*.bak
*.backup

# ==================== DOCKER ====================
docker-volumes/
*.dockerignore

# ==================== SECURITY ====================
*.pem
*.key
*.crt
secrets/

# ==================== COMPRESSED FILES ====================
*.zip
*.tar.gz
*.rar

# ==================== PROJECT SPECIFIC ====================
# Keep these commented if you want to track them
# frontend/.gitignore
# backend/.gitignore
